# syntax=docker/dockerfile:1.7
# Reproducible BlastUrban worker built directly from this repository checkout.
FROM ubuntu:22.04

ARG DEBIAN_FRONTEND=noninteractive
ARG BUILD_JOBS=8

SHELL ["/bin/bash", "-c"]
ENV HOME=/root

# OpenFOAM Foundation publishes OpenFOAM 9 packages for Ubuntu 22.04 (jammy).
# Keep SSH and Docker administration on the host; this batch worker exposes no
# network port.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        git \
        gnuplot \
        libopenmpi-dev \
        openmpi-bin \
        python3 \
        python3-vtk9 \
        rsync \
        software-properties-common \
        wget \
    && wget -qO /etc/apt/trusted.gpg.d/openfoam.asc https://dl.openfoam.org/gpg.key \
    && add-apt-repository -y http://dl.openfoam.org/ubuntu \
    && apt-get update \
    && apt-get install -y --no-install-recommends openfoam9 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/blastfoam
COPY Allwmake /opt/blastfoam/Allwmake
COPY applications /opt/blastfoam/applications
COPY etc /opt/blastfoam/etc
COPY src /opt/blastfoam/src

RUN case "$BUILD_JOBS" in ''|*[!0-9]*) echo "BUILD_JOBS must be a positive integer" >&2; exit 2;; esac \
    && (( BUILD_JOBS >= 1 )) \
    && chmod 0555 /opt/blastfoam/Allwmake \
    && source /opt/openfoam9/etc/bashrc \
    && source /opt/blastfoam/etc/bashrc \
    && ./Allwmake -j "$BUILD_JOBS"

# Fail the image build rather than discovering an incomplete solver after a
# case has already crossed SSH/rsync. This invokes help only; it runs no CFD.
RUN source /opt/openfoam9/etc/bashrc \
    && source /opt/blastfoam/etc/bashrc \
    && for command in \
        surfaceCheck surfaceFeatures blockMesh checkMesh decomposePar \
        snappyHexMesh addEmptyPatch setRefinedFields blastFoam \
        blastToVTK calculateImpulse mpirun; do \
            command -v "$command" >/dev/null || { echo "missing executable: $command" >&2; exit 3; }; \
        done \
    && blastFoam -help >/dev/null \
    && /usr/bin/python3 -c 'import vtk; print("Python VTK", vtk.VTK_VERSION)'

COPY tools/blast_case_ui/assets/blasturban-container-entrypoint.sh \
    /usr/local/bin/blasturban-container-entrypoint
RUN chmod 0555 /usr/local/bin/blasturban-container-entrypoint

WORKDIR /case
ENTRYPOINT ["/usr/local/bin/blasturban-container-entrypoint"]
CMD ["bash"]
