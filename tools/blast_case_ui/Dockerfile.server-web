# Add the Python VTK exporter to an existing blastFoam/OpenFOAM 9 image.
ARG BASE_IMAGE=local/blastfoam9:6.2.0-of9-complete
FROM ${BASE_IMAGE}

USER root
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get -qq -o=Dpkg::Use-Pty=0 update \
    && apt-get -qq -o=Dpkg::Use-Pty=0 install -y python3 python3-vtk7 \
    && rm -rf /var/lib/apt/lists/*

# Some older blastFoam .deb images contain these sources but omit the two
# post-processing executables required by building3DWorkshop/Allrun.
RUN bash -lc 'set +e; \
    for f in /opt/openfoam9/etc/bashrc /root/OpenFOAM/OpenFOAM-9/etc/bashrc /root/OpenFOAM/OpenFOAM-v9/etc/bashrc; do \
        if [ -f "$f" ]; then source "$f"; break; fi; \
    done; \
    blast_root=""; \
    for f in /opt/blastfoam/etc/bashrc /opt/BlastUrban/etc/bashrc /root/OpenFOAM/blastfoam/etc/bashrc; do \
        if [ -f "$f" ]; then source "$f"; blast_root=${f%/etc/bashrc}; break; fi; \
    done; \
    set -e; test -n "$blast_root"; \
    for utility in blastToVTK calculateImpulse; do \
        if ! command -v "$utility" >/dev/null 2>&1; then \
            wmake "$blast_root/applications/utilities/$utility"; \
            wclean "$blast_root/applications/utilities/$utility"; \
        fi; \
        command -v "$utility" >/dev/null; \
    done'
