# Copy this file to .remote.env and change the values for your server.
# Use absolute paths on the server; shell shortcuts such as ~ are not expanded.

REMOTE_HOST="your-user@your-server"
REMOTE_DIR="/home/your-user/OpenFOAM/blastfoam"
REMOTE_OPENFOAM_BASHRC="/home/your-user/OpenFOAM/OpenFOAM-9/etc/bashrc"

# Build parallelism. This does not control the number of MPI ranks for a case.
REMOTE_BUILD_JOBS="8"

# Optional SSH settings. Leave empty when they are not needed.
REMOTE_PORT=""
REMOTE_IDENTITY_FILE=""
